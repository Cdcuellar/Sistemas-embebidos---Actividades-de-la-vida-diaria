# Doxygen configuration for ESP32-S3 Touch IMU transmitter project

PROJECT_NAME           = "Monitor Touch - Nodo Slave"
PROJECT_BRIEF          = "Nodo slave IMU/Touch por ESP-NOW con clasificacion de actividad (PARADO/ACOSTADO/CAMINANDO/CAIDA) y payload 40B"
PROJECT_NUMBER         = "1.1"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Spanish

# Input scope
INPUT                  = main CMakeLists.txt prueba_clasificacion_log.txt
FILE_PATTERNS          = *.c *.cpp *.h *.hpp *.md *.txt
RECURSIVE              = YES
EXCLUDE                = build .vscode .git
EXCLUDE_PATTERNS       = */build/*

# Extraction behavior
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Parsing and preprocessing for C/C++ (ESP-IDF style)
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES

# Disable LaTeX output
GENERATE_LATEX         = NO

# Optional graphs (requires Graphviz installed)
HAVE_DOT               = NO
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_MULTI_TARGETS      = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES
